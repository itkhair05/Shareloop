# ShareLoop frontend environment variables.
# Copy to .env.local for local development. Cloudflare Pages values are set in
# the project dashboard (Settings -> Environment variables).

# Base URL of the ShareLoop backend API.
# Development: http://localhost:8080 (the Vite dev server proxies /api/*).
# Production: an absolute HTTPS URL, for example https://shareloop-api.onrender.com
# or a custom API domain. Production builds fail when this is missing or not HTTPS.
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth Web Client ID. Leave blank to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
