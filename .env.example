# PostgreSQL Configuration (Docker Compose & Local Development)
POSTGRES_DB=shareloop_db
POSTGRES_USER=shareloop_user
POSTGRES_PASSWORD=shareloop_password
POSTGRES_PORT=5432

# Spring Boot Datasource Overrides (Optional)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shareloop_db
SPRING_DATASOURCE_USERNAME=shareloop_user
SPRING_DATASOURCE_PASSWORD=shareloop_password

# Security & JWT Configuration
# Required: Secret key for HMAC-SHA256 signature verification (must be at least 32 characters / 256 bits)
JWT_SECRET=your_minimum_32_character_long_secret_key_here
# Optional: Access token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Configuration
# Optional: Comma-separated list of allowed origins for frontend applications
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Development Marketplace Seeder (Optional)
# Set to 'true' to seed local development listings (only active under 'dev' profile)
APP_SEED_ENABLED=false

# ==============================================================================
# Email & Password Reset Configuration
# Note: .env.example is documentation for reference. Spring Boot does not
# automatically load .env files without explicit configuration or shell export.
# In production (prod profile), FRONTEND_BASE_URL must strictly use HTTPS.
# ==============================================================================

# Email provider: 'mock' for local development/testing, 'brevo' for real transactional email delivery
MAIL_PROVIDER=mock

# Brevo credentials (required when MAIL_PROVIDER=brevo; never commit real credentials)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@shareloop.vn
BREVO_SENDER_NAME=ShareLoop
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT_SECONDS=5

# Frontend base URL used to construct password reset links
# Note: For production ('prod' profile), this MUST be a valid absolute HTTPS URL (e.g. https://shareloop.vn)
FRONTEND_BASE_URL=http://localhost:5173

# Password Reset Security & Token Lifecycle
FORGOT_PASSWORD_SECRET=
RESET_TOKEN_EXPIRATION_MINUTES=15
FORGOT_PASSWORD_IP_LIMIT=5
FORGOT_PASSWORD_EMAIL_LIMIT=3
FORGOT_PASSWORD_WINDOW_SECONDS=900
FORGOT_PASSWORD_ATTEMPT_RETENTION_HOURS=24
PASSWORD_RESET_TOKEN_RETENTION_DAYS=7
PASSWORD_RESET_CLEANUP_CRON=0 0 * * * *
